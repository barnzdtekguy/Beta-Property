# Supabase project settings — find these in Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-only, NEVER exposed to the browser.
# Registration, sign-in, and the CSV/Excel export routes all depend on
# this being the real `service_role` secret key, not the anon key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
